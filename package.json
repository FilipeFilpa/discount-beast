{
  "name": "discount-beast",
  "version": "0.1.0",
  "private": true,
  "description": "Extensão pessoal do Chrome que encontra e testa cupons de desconto.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "collect": "node collector/collect.ts",
    "test": "node --test \"collector/**/*.test.ts\" \"lib/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
